# Copy to .env.local and fill in. Leave blank to run in demo mode.

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after creating the webhook (npm run setup:webhook)
PAYPAL_WEBHOOK_ID=
# Optional: force demo mode even when keys are set
# HOLDFAST_MODE=demo

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Minimum gap between Gemini calls in ms (free tier has low per-minute limits)
GEMINI_MIN_GAP_MS=4000
